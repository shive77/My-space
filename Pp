2c) TRANSITIVE 
kill(all)$
A: makelist(k,k,1,4);
R1: [[1,1],[1,2],[2,1],[2,2],[3,4],[4,1],[4,4]];

checkTransitive(A,R):=block(
[s:0],
for i:1 thru length(A) do
for j:1 thru length(A) do
for k:1 thru length(A) do
if member([A[i],A[j]],R) and member([A[j],A[k]],R)
then if not member([A[i],A[k]],R) then s:1,
if s=1 then return("Not transitive"),
return("Transitive")
);
checkTransitive(A,R1);

3a) COVERING RELATION 
kill(all)$
findCoveringRelation(A,R):=block(
[C:[], nR:[], s,e,f],
for k:1 thru length(R) do
if R[k][1]#R[k][2] then nR:cons([R[k][1],R[k][2]],nR),
for j:1 thru length(nR) do(
e:nR[j][1],
f:nR[j][2],
s:0,
for i:1 thru length(A) do
if member([e,A[i]],nR) and member([A[i],f],nR) then s:s+1,
if s=0 then C:cons([e,f],C)
),
return(C)
);
A:[2,3,4,6,8];
R:[[2,4],[2,6],[2,8],[3,6],[4,8]];
C1:findCoveringRelation(A,R);

