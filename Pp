3c) GREATEST ELEMENT 
kill(all);
gElement(A, R):=block(
    [s, f:0, t:0],
    for j:1 thru length(A) do(
        s:0,
        for i:1 thru length(A) do(
            if(member([A[i], A[j]], R)) then(s:s+1)
        ),
        if(s=length(A)) then(t:j, return(t))
    ),
    if(t=0) then(return("no greatest element"))
    else(return(concat(A[t], " is the greatest element")))
);
