kill(all);
depends(x,t);
depends(y,t);
b:0.1;
c1:0.001;
c2:0.005;
a:0.5;
x0:200;
y0:80;

eq1:diff(x,t)=b.x-c1•x•y;
eq2:diff(y,t)=c2•x•y-a•y;

sol:rk([rhs(eq1),rhs(eq2)],[x,y],[x0,y0],[t,0,25,2])$;
p1:makelist([p[1],p[2]],p,sol);
wxplot2d([discrete,p1]);
p2:makelist([p[1],p[3]],p,sol);
wxplot2d([[discrete,p1],[discrete,p2]]);
