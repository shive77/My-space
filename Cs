1) Retrieve names of students enrolled in any society
SELECT DISTINCT StudentName
FROM STUDENT S
JOIN ENROLLMENT E ON S.RollNo = E.RollNo;

2) Retrieve all society names
SELECT SocName FROM SOCIETY;

3)Students whose names start with A
SELECT * FROM STUDENT
WHERE StudentName LIKE 'A%';

4)Students studying Computer Science or Chemistry
SELECT * FROM STUDENT
WHERE Course IN ('Computer Science', 'Chemistry');

5)Roll numbers not starting with X or Z and ending with 9
SELECT StudentName FROM STUDENT
WHERE RollNo NOT LIKE 'X%'
AND RollNo NOT LIKE 'Z%'
AND RollNo LIKE '%9';

6)Society details with more than N seats
SET @N = 30;
SELECT * FROM SOCIETY
WHERE TotalSeats > @N;

7)Update mentor name of a specific society
UPDATE SOCIETY
SET MentorName = 'Amit'
WHERE SocID = 'S1';
SELECT * FROM SOCIETY
WHERE SocID = 'S1';

8)Society names with more than five enrolled students
SELECT SocName
FROM SOCIETY S
JOIN ENROLLMENT E ON S.SocID = E.SID
GROUP BY S.SocID, S.SocName
HAVING COUNT(E.RollNo) > 5;

9)Youngest student enrolled in NSS
SELECT StudentName
FROM STUDENT S
JOIN ENROLLMENT E ON S.RollNo = E.RollNo
JOIN SOCIETY SO ON E.SID = SO.SocID
WHERE SO.SocName = 'NSS'
ORDER BY DOB DESC
LIMIT 1;

10)Most popular society
SELECT SO.SocName, COUNT(*) AS Total
FROM SOCIETY SO
JOIN ENROLLMENT E ON SO.SocID = E.SID
GROUP BY SO.SocID, SO.SocName
ORDER BY Total DESC
LIMIT 1;
